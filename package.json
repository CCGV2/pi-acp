{
	"name": "@ccgv2/pi-acp",
	"version": "0.7.0",
	"description": "ACP adapter for pi coding agent",
	"license": "MIT",
	"author": "CCGV2",
	"repository": {
		"type": "git",
		"url": "https://github.com/CCGV2/pi-acp.git"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"bugs": {
		"url": "https://github.com/CCGV2/pi-acp/issues"
	},
	"homepage": "https://github.com/CCGV2/pi-acp#readme",
	"keywords": [
		"acp",
		"agent-client-protocol",
		"pi-coding-agent",
		"adapter"
	],
	"engines": {
		"node": ">=24"
	},
	"type": "module",
	"main": "dist/index.mjs",
	"bin": {
		"pi-acp": "dist/index.mjs"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "tsx src/index.ts",
		"build": "tsdown",
		"start": "node dist/index.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "npm run lint:biome && npm run lint:oxlint",
		"lint:biome": "biome check .",
		"lint:oxlint": "oxlint --import-plugin --type-aware --tsconfig=./tsconfig.json src/",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "vitest run",
		"prepack": "npm run build",
		"prepublishOnly": "npm test && npm run build"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "^0.22.1",
		"@earendil-works/pi-agent-core": "0.75.3",
		"@earendil-works/pi-ai": "0.75.3",
		"@earendil-works/pi-coding-agent": "0.75.3",
		"@modelcontextprotocol/sdk": "1.29.0",
		"typebox": "^1.1.38",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@commitlint/cli": "^20.5.0",
		"@commitlint/config-conventional": "^20.5.0",
		"@limegrass/eslint-plugin-import-alias": "^1.6.1",
		"@semantic-release/changelog": "6",
		"@semantic-release/git": "10",
		"@semantic-release/github": "12",
		"@semantic-release/npm": "13",
		"@types/node": "^25.5.0",
		"eslint-plugin-zod": "^3.5.0",
		"lefthook": "^2.1.4",
		"oxlint": "^1.56.0",
		"oxlint-tsgolint": "^7.0.2001",
		"semantic-release": "25",
		"tsdown": "^0.21.4",
		"tsx": "^4.20.3",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4"
	}
}
